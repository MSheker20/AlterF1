#!/bin/sh
# Rejects any commit that contains AI / agent files, even if they were added with `git add -f`.
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(CLAUDE(\.local)?\.md|AGENTS\.md|GEMINI\.md|PLAN\.md|\.mcp\.json)$|(^|/)\.(claude|agents|gemini)/|(^|/)graphify-out/')
if [ -n "$blocked" ]; then
  echo "pre-commit: AI dosyaları commit'lenemez:" >&2
  echo "$blocked" | sed 's/^/  - /' >&2
  echo "Kaldırmak için: git rm --cached <dosya>" >&2
  exit 1
fi
